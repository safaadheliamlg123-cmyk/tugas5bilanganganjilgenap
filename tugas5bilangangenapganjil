#include <iostream>
using namespace std;

int main() {
    int angka;

    cout << "==================================" << endl;
    cout << "  PROGRAM MENENTUKAN GENAP GANJIL " << endl;
    cout << "==================================" << endl;

    cout << "Masukkan bilangan bulat: ";
    cin >> angka;

    cout << "\nHasil Pemeriksaan" << endl;
    cout << "----------------------------------" << endl;
    cout << "Angka yang dimasukkan : " << angka << endl;

    if (angka % 2 == 0) {
        cout << "Jenis bilangan        : Genap" << endl;
    } else {
        cout << "Jenis bilangan        : Ganjil" << endl;
    }

    cout << "----------------------------------" << endl;
    cout << "Program selesai." << endl;

    return 0;
}
